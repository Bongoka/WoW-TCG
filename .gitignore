# Betriebssystem
Thumbs.db
desktop.ini
.DS_Store

# Editor
.vscode/
.idea/
*.swp

# Node (Testskripte)
node_modules/

# Lokale Claude-Einstellungen
.claude/settings.local.json

# Testbilder für die Bild-Test-Szene (bleiben lokal)
test/*
!test/.gitkeep

# Große Bildordner nur lokal (Repo/GitHub Pages bleibt klein): Originale in hoher Auflösung und Scans.
# Das Spiel erkennt fehlende Ordner und blendet die Bild-Optionen dann aus.
cards/* big/
cards/* scans/
cards/* scans small/


